# ====================================================================
# EduAcademy — Production & Development Environment Template
# NOTE: Never commit live credentials or secret keys to source control!
# In production, set these variables in your hosting provider dashboards
# (e.g., Vercel, Netlify, Render, Railway).
# ====================================================================

# ====================================================================
# SECTION A: BACKEND ENVIRONMENT VARIABLES
# (Set in Render / Railway / Server Host Dashboard)
# ====================================================================

# 1. Server Runtime & Port
# Render / Railway dynamically provide PORT in production
PORT=5000
NODE_ENV=production

# 2. Production Frontend Origin for CORS
# In production, set to your live website URL:
FRONTEND_URL=https://www.MYDOMAIN.com

# Optional: Comma-separated list of additional allowed origins
# ALLOWED_ORIGINS=https://www.MYDOMAIN.com,https://MYDOMAIN.com

# 3. Supabase Cloud Connection (Backend)
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 4. Direct PostgreSQL Database Connection
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# 5. JWT Secret
# Cryptographically secure random string (minimum 32 characters)
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_MIN_32_CHARS

# 6. Payment Gateway (Optional / When configured)
PAYMENT_SECRET_KEY=YOUR_PAYMENT_SECRET_KEY
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_WEBHOOK_SIGNING_SECRET


# ====================================================================
# SECTION B: FRONTEND PUBLIC VARIABLES (Vite)
# (Set in Vercel / Netlify Dashboard -> Environment Variables)
# NOTE: Only variables prefixed with VITE_ are bundled into the browser.
# NEVER put private backend secrets here!
# ====================================================================

# 1. Backend REST API URL
# In production, points to your live backend domain:
VITE_API_URL=https://api.MYDOMAIN.com/api/v1

# 2. Supabase Cloud Client (Public)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 3. Public Payment Key (Optional)
VITE_PAYMENT_PUBLIC_KEY=YOUR_PUBLIC_PAYMENT_KEY
