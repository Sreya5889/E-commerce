    "answers": [
      {
        "question_id": "q-quant-01",
        "question_text": "If the price of a computer software license increases by 25%, by what percentage must a company reduce its consumption of licenses so that total expenditure remains unchanged?",
        "options": [
          {
            "key": "A",
            "text": "20%"
          },
          {
            "key": "B",
            "text": "25%"
          },
          {
            "key": "C",
            "text": "16.66%"
          },
          {
            "key": "D",
            "text": "18.75%"
          }
        ],
        "difficulty": "easy",
        "selected_option": "A",
        "correct_option": "A",
        "is_correct": true,
        "explanation": "Let original price = $100 and consumption = 100 units. Original expenditure = 100 × 100 = 10,000. New price = $125. To keep expenditure at 10,000, new consumption = 10,000 / 125 = 80 units. Reduction = 100 - 80 = 20%. Formula: [R / (100 + R)] × 100% = [25 / 125] × 100% = 20%.",
        "time_spent_seconds": 30,
        "topic_id": "top-quant-percentages",
        "category_id": "cat-quant"
      },
      {
        "question_id": "q-quant-02",
        "question_text": "A merchant sells an electronic gadget for $840 at a profit of 20%. If he had sold it for $714, what would have been his profit or loss percentage?",
        "options": [
          {
            "key": "A",
            "text": "2% Profit"
          },
          {
            "key": "B",
            "text": "2% Loss"
          },
          {
            "key": "C",
            "text": "4% Profit"
          },
          {
            "key": "D",
            "text": "5% Loss"
          }
        ],
        "difficulty": "medium",
        "selected_option": "B",
        "correct_option": "A",
        "is_correct": false,
        "explanation": "Selling Price (SP1) = $840 with 20% profit. Cost Price (CP) = 840 / 1.20 = $700. New Selling Price (SP2) = $714. Profit = 714 - 700 = $14. Profit % = (14 / 700) × 100% = 2% profit.",
        "time_spent_seconds": 40,
        "topic_id": "top-quant-profit-loss",
        "category_id": "cat-quant"
      }
    ],
