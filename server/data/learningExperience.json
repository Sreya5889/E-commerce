  "quizzes": [
    {
      "id": "quiz-l1",
      "course_id": "c1",
      "lesson_id": "l1",
      "title": "React Architecture & Component Lifecycle Check",
      "passing_score": 70,
      "questions": [
        {
          "id": "q1",
          "question": "What is the primary advantage of React 19 Actions over manual async state handling?",
          "options": [
            "They automatically manage pending states, optimistic updates, and error handling",
            "They force the entire application into client-side rendering",
            "They eliminate the need for JavaScript in the browser",
            "They replace CSS animations with WebGL"
          ],
          "correct_index": 0,
          "explanation": "React Actions streamline asynchronous transactions by natively coordinating pending states, error boundaries, and optimistic UI transitions."
        },
        {
          "id": "q2",
          "question": "When designing an offline-first learning system, where should student progress first be committed?",
          "options": [
            "Only in third-party analytics",
            "In local fast-access storage with background synchronizer queue to the backend",
            "Directly to a blockchain ledger",
            "Strictly in server session cookies without client cache"
          ],
          "correct_index": 1,
          "explanation": "An offline-first design commits immediately to resilient local storage (IndexedDB/localStorage) and dispatches an asynchronous reconciliation queue to the cloud database."
        },
        {
          "id": "q3",
          "question": "What is the time complexity of looking up a lesson bookmark in a JavaScript Set or Hash Map?",
          "options": [
            "O(N)",
            "O(N log N)",
            "O(1) average time",
            "O(N^2)"
          ],
          "correct_index": 2,
          "explanation": "Sets and Hash Maps use bucketed hash indexing providing O(1) average constant-time lookups."
        }
      ],
      "created_at": "2026-09-15T09:00:00.000Z"
    }
  ],
